# Copy to trader/.env on your server:  cp .env.example .env && nano .env
# NEVER commit the real .env file.

# Second Telegram bot just for trading (create with @BotFather)
TRADE_BOT_TOKEN=
# Your Telegram chat id (same as the report bot)
TELEGRAM_CHAT_ID=

# Angel One SmartAPI (smartapi.angelone.in -> My Apps -> create app with THIS server's static IP)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# The secret shown as text/QR when you enable TOTP for SmartAPI (not the 6-digit code)
ANGEL_TOTP_SECRET=

# Safety limits
MAX_ORDER_VALUE=25000
MAX_ORDERS_PER_DAY=5
